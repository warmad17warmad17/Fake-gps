<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_row_root"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FFFFFF"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">

    <!-- Location Name & Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lokasi Favorit"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/item_coords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lat: 0.000000, Lng: 0.000000"
            android:textColor="#757575"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- Start / Stop Button (GPS Target or Red Stop) -->
    <ImageView
        android:id="@+id/item_action_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="8dp"
        android:src="@drawable/ic_widget_target_blue"
        android:contentDescription="Mulai / Berhenti Mock Lokasi"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

</LinearLayout>
